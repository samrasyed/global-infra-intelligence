"use client";

import { useState, useRef, useEffect } from "react";
import { Send, Bot, User } from "lucide-react";
import { api } from "@/lib/api";
import Link from "next/link";

interface Message {
  role: "user" | "assistant";
  text: string;
  sources?: { article_id: string; title?: string | null; source?: string | null }[];
}

const SUGGESTIONS = [
  "Which countries have the highest Chinese infrastructure investments?",
  "Show all railway projects in Africa",
  "What ports involve COSCO?",
  "Summarize recent power grid threats",
];

export default function AnalystPage() {
  const [messages, setMessages] = useState<Message[]>([
    {
      role: "assistant",
      text: "I'm the GCIIP analyst assistant. Ask me about infrastructure investments, threats, or specific countries and companies — I'll answer from indexed articles and cite sources.",
    },
  ]);
  const [input, setInput] = useState("");
  const [loading, setLoading] = useState(false);
  const bottomRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    bottomRef.current?.scrollIntoView({ behavior: "smooth" });
  }, [messages]);

  async function send(text: string) {
    if (!text.trim() || loading) return;
    setMessages((m) => [...m, { role: "user", text }]);
    setInput("");
    setLoading(true);
    try {
      const res = await api.chat(text);
      setMessages((m) => [...m, { role: "assistant", text: res.answer, sources: res.sources }]);
    } catch {
      setMessages((m) => [...m, { role: "assistant", text: "The assistant is unavailable right now. Confirm the backend is running." }]);
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="max-w-3xl mx-auto flex flex-col h-[calc(100vh-8rem)]">
      <div className="mb-4">
        <h1 className="font-display text-xl font-semibold text-ink">Analyst Assistant</h1>
        <p className="text-sm text-ink-muted mt-1">Retrieval-augmented Q&A grounded in indexed intelligence.</p>
      </div>

      <div className="flex-1 overflow-y-auto space-y-4 pr-1">
        {messages.map((m, i) => (
          <div key={i} className={`flex gap-3 ${m.role === "user" ? "justify-end" : ""}`}>
            {m.role === "assistant" && (
              <div className="w-7 h-7 rounded-md bg-surface-3 flex items-center justify-center shrink-0 text-signal">
                <Bot size={14} />
              </div>
            )}
            <div className={`max-w-[80%] ${m.role === "user" ? "order-first" : ""}`}>
              <div
                className={
                  m.role === "user"
                    ? "bg-cobalt/15 border border-cobalt/30 rounded-lg px-4 py-3 text-sm text-ink"
                    : "glass-panel rounded-lg px-4 py-3 text-sm text-ink leading-relaxed"
                }
              >
                {m.text}
              </div>
              {m.sources && m.sources.length > 0 && (
                <div className="flex flex-wrap gap-1.5 mt-2">
                  {m.sources.map((s) => (
                    <Link
                      key={s.article_id}
                      href={`/articles/${s.article_id}`}
                      className="px-2 py-0.5 rounded border border-border text-[10px] text-ink-faint hover:text-signal hover:border-signal/40"
                    >
                      {s.title || "source"}
                    </Link>
                  ))}
                </div>
              )}
            </div>
            {m.role === "user" && (
              <div className="w-7 h-7 rounded-md bg-cobalt/20 flex items-center justify-center shrink-0 text-cobalt">
                <User size={14} />
              </div>
            )}
          </div>
        ))}
        {loading && <div className="text-xs text-ink-faint font-mono pl-10">analyzing…</div>}
        <div ref={bottomRef} />
      </div>

      {messages.length === 1 && (
        <div className="flex flex-wrap gap-2 mb-3">
          {SUGGESTIONS.map((s) => (
            <button
              key={s}
              onClick={() => send(s)}
              className="px-3 py-1.5 rounded-md border border-border text-xs text-ink-muted hover:text-ink hover:border-border-strong transition-colors"
            >
              {s}
            </button>
          ))}
        </div>
      )}

      <form
        onSubmit={(e) => {
          e.preventDefault();
          send(input);
        }}
        className="relative mt-2"
      >
        <input
          value={input}
          onChange={(e) => setInput(e.target.value)}
          placeholder="Ask about infrastructure, threats, investments…"
          className="w-full pl-4 pr-12 py-3 rounded-lg bg-surface-2 border border-border focus:border-signal/50 outline-none text-sm text-ink placeholder:text-ink-faint"
        />
        <button
          type="submit"
          disabled={loading}
          className="absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 rounded-md bg-signal/15 text-signal flex items-center justify-center hover:bg-signal/25 transition-colors disabled:opacity-40"
        >
          <Send size={14} />
        </button>
      </form>
    </div>
  );
}
